PORT=3000
# MySQL local (Laragon): usuário root sem senha
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=gametask
# Alternativa: DATABASE_URL=mysql://user:pass@host:3306/gametask
SESSION_SECRET=troque-por-um-segredo-longo
TZ=America/Sao_Paulo
# E-mail(s) da conta do dono do sistema (painel de assinaturas e faturamento), separados por vírgula
OWNER_EMAILS=seu@email.com
# Mercado Pago: Access Token de PRODUÇÃO (Suas integrações > Credenciais)
MP_ACCESS_TOKEN=
# Endereço público do app (para o retorno do pagamento e o webhook)
APP_URL=https://gametask.startingpro.com.br
